{
  "Serilog": {
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "events-.log",
          "restrictedToMinimumLevel": "Information",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Debug"
        }
      }
    ]
  },
  "ManagementOptions": {
    "DefaultCertPath": "config/default.ovpn",
    "DefaultPrivateKeyOVpn": "",
    "PaymentCards": [
      {
        "BankName": "بانک نمونه",
        "CardNumber": "0000-0000-0000-0000",
        "HolderName": "شرکت نمونه"
      }
    ],
    "WalletDeactivationThreshold": null,
    "ReceiptMaxBytes": 2097152,
    "UnmeteredPlanDemandGigabytes": 25,
    "MinUuidRotationMinutes": 60,
    "AllowRegistration": false
  },
  "BrandingOptions": {
    "Title": "Fast Bypass",
    "SiteUrl": "https://photon-bypass.com",
    "ConnectionGuideUrl": "https://drive.google.com/drive/u/1/folders/1qv_TUemGNftxNcHnz2DnPn9V6S39Pfij",
    "OvpnInstallerUrl": "https://drive.google.com/drive/u/1/folders/14jaxqfGGHvG5KIfkPpzMzsL5Hg8ktZxh",
    "LogoPath": "Branding/logo.png"
  },
  "SocialMediaOptions": {
    "Channel": "None"
  },
  "AllowedHosts": "*",
  "RateLimitOptions": {
    "PermitLimit": 10,
    "WindowSeconds": 60,
    "forget": { "PermitLimit": 3 },
    "register": { "PermitLimit": 5 },
    "reset": { "PermitLimit": 5 },
    "captcha": { "PermitLimit": 30 }
  },
  "CaptchaOptions": {
    "Enabled": true,
    "CodeLength": 5,
    "CodeExpirySeconds": 180,
    "FailureThreshold": 3,
    "FailureWindowMinutes": 15,
    "ImageWidth": 200,
    "ImageHeight": 70
  },
  "Issuer": {
    "Name": "domain.com"
  }
}
