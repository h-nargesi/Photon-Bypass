# Config for OpenVPN 3 C++
client
dev tun
proto tcp
setenv FRIENDLY_NAME "Title"
remote server.domain.name
nobind
tls-client
remote-cert-tls server
tun-mtu 1400
tun-mtu-extra 32
mssfix 1360
group nogroup
ping 15
ping-restart 45
persist-tun
persist-key
mute-replay-warnings
verb 4
cipher AES-256-GCM
auth SHA512
pull
auth-user-pass
connect-retry 1

