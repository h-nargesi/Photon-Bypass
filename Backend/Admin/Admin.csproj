<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>PhotonBypass.Admin</RootNamespace>
		<!-- The host serves pure JSON APIs and owns no static assets: the SDK's
		     DotNetWatch browser bundle has no endpoints here and newer SDKs
		     (11 RC) fail the build over it — disable static web assets. -->
		<StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Portal\Portal.csproj" />
		<ProjectReference Include="..\ServiceFactoryHandler\ServiceFactoryHandler.csproj" />
		<ProjectReference Include="..\Shared\Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="PhotonBypass.Test" />
	</ItemGroup>
</Project>
